# MongoDB Atlas connection string. Replace the placeholders; URL-encode special
# characters in the database user's password. For local Docker MongoDB use:
# mongodb://mongodb:27017
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/softarchitect_ai?retryWrites=true&w=majority
MONGODB_DATABASE=softarchitect_ai

# JWT
JWT_SECRET=replace_with_a_random_secret_at_least_32_characters_long
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# LLM Provider
# mock always uses local deterministic agents.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Set false and LLM_PROVIDER=gemini to enable online Gemini analysis.
DEMO_MODE=true

# Frontend
CORS_ORIGINS=["http://localhost:5173","http://localhost:4173"]
